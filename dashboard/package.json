{
  "name": "slb-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "serve:api": "node server/server.mjs",
    "test:contract": "node scripts/test-contract.mjs",
    "test:refresh": "node --import tsx scripts/test-refresh.tsx",
